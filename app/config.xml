<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/nicbra/f1tv-tizen" version="0.0.0" viewmodes="maximized">
    <tizen:application id="F1TVtizen1.F1TV" package="F1TVtizen1" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>F1 TV</name>
    <description>Unofficial F1 TV client for Samsung Tizen TVs</description>
    <author href="https://github.com/nicbra/f1tv-tizen" email="git@nicbra.no">nicbra</author>
    <license href="https://github.com/nicbra/f1tv-tizen/blob/master/LICENSE">MIT</license>
    <icon src="img/icon.png"/>
    <content src="launcher/boot.html"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <feature name="http://tizen.org/feature/web.service"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>

    <!-- F1's APIs, video CDNs and GitHub for updates. Open, so later versions can reach new hosts. -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <!-- MSE playback needs blob: media, which the default policy blocks. -->
    <tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; media-src * blob: data:; img-src * data: blob:</tizen:content-security-policy>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drmplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <!-- Local helper on 127.0.0.1:18765. It installs updates, serves downloaded versions and fixes streams. -->
    <tizen:service id="F1TVtizen1.Helper">
        <tizen:content src="launcher/service.js"/>
        <tizen:name>F1TVHelper</tizen:name>
        <tizen:description>Updates and stream helper for F1 TV</tizen:description>
    </tizen:service>
</widget>
